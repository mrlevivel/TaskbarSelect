        sealed class Receipt : WarningObservation
        {
            public string schema = "taskbar-select-private-update-fixture-v1";
            public string status = "running", phase = "entry", currentVersion = "1.0.0-beta.16", targetVersion = Target;
            public string setupPath, setupSha256, settingsSha256, errorType;
