        static void ReadWarningConsent(string assets)
        {
            string path = Path.Combine(assets, "private-unsigned-warning-consent.json");
            warningConsentPresent = File.Exists(path);
            if (!warningConsentPresent) return; // DEFAULT OFF; no action authority.
