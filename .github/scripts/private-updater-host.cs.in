                        afterYesClickReturned = afterYesClickReturned, stage5Launching = Launching(), stage5ActiveLaunch = ActiveLaunch() != null };
                    lock (exceptionGate) {
                        value.launchExceptionType = launchExceptionType; value.launchExceptionHresult = launchExceptionHresult;
                        value.launchNativeError = launchNativeError; value.launchExceptionCount = launchExceptionCount;
                    }
                    int seen = 0;
                    EnumThreadWindows(uiThread, delegate(IntPtr window, IntPtr state) {
                        if (watchdogStop.WaitOne(0)) return false;
                        uint owner; GetWindowThreadProcessId(window, out owner);
                        if (owner != value.fixturePid || !IsWindowVisible(window) || Text(window, true) != "#32770") return true;
                        if (++seen > 8) { value.dialogEnumerationTruncated = true; return false; }
                        var title = new StringBuilder(256); UIntPtr result;
                        if (SendMessageTimeout(window, 0x000d, new UIntPtr((uint)title.Capacity), title, 2, 500, out result) == IntPtr.Zero || result.ToUInt64() >= 255) value.unresponsiveDialogCount++;
                        else if (title.ToString() == "Install update") value.installDialogCount++;
                        else if (title.ToString() == "Open File - Security Warning") { value.securityDialogCount++; ProbeNormalWarning(window); }
                        else value.unknownDialogCount++;
                        return true;
                    }, IntPtr.Zero);
                    CopyWarning(value);
                    string serialized = new JavaScriptSerializer().Serialize(value); Require(serialized.Length < 8192);
                    string temporary = watchdogPath + ".next"; Require(!File.Exists(temporary));
                    using (var file = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.Read)) {
                        byte[] bytes = new UTF8Encoding(false).GetBytes(serialized); file.Write(bytes, 0, bytes.Length); file.Flush(true);
                    }
                    if (File.Exists(watchdogPath)) File.Replace(temporary, watchdogPath, null); else File.Move(temporary, watchdogPath);
                } catch (Exception) {
                    // Observation is optional and cannot change app state,
                    // dismiss an unknown dialog or turn a failure into a pass.
                    return;
                }
            }
        }
        static void Write(string phase)
        {
            receipt.phase = phase;
            if (receiptPath == null) return;
            CopyWarning(receipt);
            string temporary = receiptPath + ".next";
            Require(!File.Exists(temporary));
            string value = json.Serialize(receipt); Require(value.Length < 16384);
            using (var file = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.Read)) {
                byte[] bytes = new UTF8Encoding(false).GetBytes(value); file.Write(bytes, 0, bytes.Length); file.Flush(true);
            }
            if (File.Exists(receiptPath)) File.Replace(temporary, receiptPath, null); else File.Move(temporary, receiptPath);
        }
        static void Require(bool value) { if (!value) throw new InvalidOperationException("Private updater fixture admission or assertion failed."); }
        static bool Same(string a, string b) { return String.Equals(Path.GetFullPath(a), Path.GetFullPath(b), StringComparison.OrdinalIgnoreCase); }
        static string BoundedPath(string root, string value)
        {
            string path = Path.GetFullPath(value);
            Require(Path.IsPathRooted(value) && path.StartsWith(root.TrimEnd('\\') + "\\", StringComparison.OrdinalIgnoreCase)); return path;
        }
        static void OrdinaryPath(string value)
        {
            for (string path = Path.GetFullPath(value); path != null; path = Path.GetDirectoryName(path.TrimEnd('\\')))
                Require((File.GetAttributes(path) & FileAttributes.ReparsePoint) == 0);
        }
        static string Hash(string path)
        {
            OrdinaryPath(path);
            using (var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read)) return AppUpdateService.Hash(file, CancellationToken.None);
        }
        sealed class PinnedTransport : IAppUpdateTransport, IDisposable
        {
            readonly FileStream setup, sums;
            readonly byte[] feed;
            internal int ReadEvents;
            internal PinnedTransport(string assets)
            {
                string setupPath = Path.Combine(assets, AppUpdatePolicy.InstallerName(Target));
                string sumsPath = Path.Combine(assets, "SHA256SUMS.txt"); OrdinaryPath(setupPath); OrdinaryPath(sumsPath);
                setup = new FileStream(setupPath, FileMode.Open, FileAccess.Read, FileShare.Read);
                sums = new FileStream(sumsPath, FileMode.Open, FileAccess.Read, FileShare.Read);
                Require(AppUpdateService.Hash(setup, CancellationToken.None) == SetupHash && AppUpdateService.Hash(sums, CancellationToken.None) == SumsHash);
                var assetsInfo = new[] {
                    new { name = AppUpdatePolicy.InstallerName(Target), state = "uploaded", size = setup.Length, browser_download_url = AppUpdatePolicy.AssetUri(Target, AppUpdatePolicy.InstallerName(Target)).AbsoluteUri, digest = "sha256:" + SetupHash },
                    new { name = "SHA256SUMS.txt", state = "uploaded", size = sums.Length, browser_download_url = AppUpdatePolicy.AssetUri(Target, "SHA256SUMS.txt").AbsoluteUri, digest = "sha256:" + SumsHash }
                };
                feed = Encoding.UTF8.GetBytes(json.Serialize(new[] { new {
                    tag_name = "v" + Target, draft = false, prerelease = true,
                    html_url = AppUpdatePolicy.Repository + "/releases/tag/v" + Target,
                    body = "Private acceptance fixture: exact hosted beta.17 package. No public release was created.", assets = assetsInfo
                } }));
            }
            public AppUpdateResponse Open(Uri address, CancellationToken cancellation)
            {
                cancellation.ThrowIfCancellationRequested();
                Require(AppUpdatePolicy.InitialUri(address));
                if (AppUpdatePolicy.SameUri(address, new Uri(AppUpdatePolicy.Feed))) return new AppUpdateResponse(new MemoryStream(feed, false), feed.Length, null);
                FileStream file = AppUpdatePolicy.SameUri(address, AppUpdatePolicy.AssetUri(Target, "SHA256SUMS.txt")) ? sums :
                    AppUpdatePolicy.SameUri(address, AppUpdatePolicy.AssetUri(Target, AppUpdatePolicy.InstallerName(Target))) ? setup : null;
                Require(file != null); file.Position = 0;
                return new AppUpdateResponse(new PinnedReadStream(file, cancellation, delegate { Interlocked.Increment(ref ReadEvents); }), file.Length, null);
            }
            public void Dispose() { if (setup != null) setup.Dispose(); if (sums != null) sums.Dispose(); }
        }
        sealed class PinnedReadStream : Stream
        {
            readonly Stream stream; readonly CancellationToken cancellation; readonly Action progress;
            internal PinnedReadStream(Stream source, CancellationToken token, Action report) { stream = source; cancellation = token; progress = report; }
            public override bool CanRead { get { return true; } } public override bool CanSeek { get { return false; } } public override bool CanWrite { get { return false; } }
            public override long Length { get { return stream.Length; } } public override long Position { get { return stream.Position; } set { throw new NotSupportedException(); } }
            public override int Read(byte[] buffer, int offset, int count) { cancellation.ThrowIfCancellationRequested(); Thread.Sleep(8); int read = stream.Read(buffer, offset, Math.Min(count, 32768)); if (read > 0) progress(); return read; }
            public override void Flush() { } public override long Seek(long offset, SeekOrigin origin) { throw new NotSupportedException(); }
            public override void SetLength(long value) { throw new NotSupportedException(); } public override void Write(byte[] buffer, int offset, int count) { throw new NotSupportedException(); }
            // The transport owns immutable source-file leases across requests.
            protected override void Dispose(bool disposing) { base.Dispose(disposing); }
        }
    }
}
