        static string Text(IntPtr window, bool className)
        { var value = new StringBuilder(2048); if (className) GetClassName(window, value, value.Capacity); else GetWindowText(window, value, value.Capacity); return value.ToString(); }
        static void HandleConfirmation(bool accept)
        {
            IntPtr found = IntPtr.Zero; int count = 0; bool unexpected = false;
            EnumThreadWindows(GetCurrentThreadId(), delegate(IntPtr window, IntPtr state) {
                if (!IsWindowVisible(window) || Text(window, true) != "#32770") return true;
                // Refuse other dialogs; never dismiss Windows security or
                // installer refusal messages under the guise of consent.
                uint owner; GetWindowThreadProcessId(window, out owner);
                if (owner != receipt.fixturePid || Text(window, false) != "Install update" || GetWindow(window, 4) != updateForm.Handle) { unexpected = true; return false; }
                found = window; count++; return true;
            }, IntPtr.Zero);
            Require(!unexpected);
            if (count == 0) return;
            Require(count == 1 && !dialogHandled);
            IntPtr button = GetDlgItem(found, accept ? 6 : 7);
            Require(button != IntPtr.Zero && IsWindowVisible(button) && IsWindowEnabled(button) && Text(button, true) == "Button" && Text(button, false).Replace("&", "") == (accept ? "Yes" : "No"));
            dialogHandled = true; stage = accept ? 5 : 3;
            if (accept) receipt.confirmedInstall = true;
            Write(accept ? "install-confirmed" : "install-declined");
            SendMessage(button, 0x00f5, IntPtr.Zero, IntPtr.Zero);
            if (accept) {
                afterYesClickReturned = true; receipt.afterYesClickReturned = true;
                // A reentrant launch/close must keep its authoritative receipt.
                if (receipt.status == "running") Write("yes-click-returned");
            }
        }
        static void Fail(Exception error)
        {
            if (receipt.status == "failed") return;
            receipt.status = "failed"; receipt.errorType = error.GetType().Name; receipt.hresult = error.HResult;
            CopyException(receipt);
            try { Write(receipt.phase); } catch (Exception) { }
        }

