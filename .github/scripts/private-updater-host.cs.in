            public bool clipQuerySucceeded = false, intendedInsideClip = false, postCursorQuerySucceeded = false, postEqualsIntended = false, postInsideRun = false;
            public bool postHitOwnedRun = false, postHitOwnedWarning = false, warningStillPresent = false;
            public bool moveCallStarted = false, moveReturned = false, moveCursorQuerySucceeded = false, moveInsideRun = false, moveHitOwnedRun = false, moveHitOwnedWarning = false, pointerVerified = false;
            public bool finalProofObserved = false, finalProofVerified = false, buttonsCallStarted = false, buttonsReturned = false;
