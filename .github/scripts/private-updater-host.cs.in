        [STAThread]
        static int Main(string[] args)
        {
            // Refuse accidental execution on a real desktop, even in lifecycle
            // dispatch. Hosted sponsor/account authentication is external.
            if (Environment.GetEnvironmentVariable("GITHUB_ACTIONS") != "true" ||
                Environment.GetEnvironmentVariable("RUNNER_ENVIRONMENT") != "github-hosted" ||
                Environment.GetEnvironmentVariable("RUNNER_OS") != "Windows" ||
                Environment.GetEnvironmentVariable("GITHUB_EVENT_NAME") != "workflow_dispatch" ||
                Environment.GetEnvironmentVariable("GITHUB_REPOSITORY") != "mrlevivel/TaskbarSelect" ||
                Environment.GetEnvironmentVariable("GITHUB_REF") != "refs/heads/codex/beta17-private-updater" ||
                !System.Text.RegularExpressions.Regex.IsMatch(Environment.GetEnvironmentVariable("GITHUB_SHA") ?? "", "\\A[a-f0-9]{40}\\z")) return 2;
            bool driver = args.Length > 0 && args[0] == "--private-update-fixture";
            try {
                if (!driver) return NormalMain(args);
                Require(args.Length == 3 && Application.ProductVersion == receipt.currentVersion);
                var identity = NativeProcessIdentity.Current;
                Require(identity.IntegrityAvailable && identity.ElevationAvailable && !identity.Elevated && identity.IntegrityLevel == NativeProcessIdentity.Medium);
                string root = Path.GetFullPath(Environment.GetEnvironmentVariable("RUNNER_TEMP"));
                Require(System.Text.RegularExpressions.Regex.IsMatch(Path.GetFileName(root.TrimEnd('\\')), "\\ATaskbarSelectCiRuntime\\.[a-f0-9]{32}\\z"));
                OrdinaryPath(root);
                string assets = BoundedPath(root, args[1]);
                receiptPath = BoundedPath(root, args[2]);
                Require(Same(assets, Path.Combine(root, "private-updater-input")) && Same(receiptPath, Path.Combine(root, "private-fixture-receipt.json")));
                Require(Directory.Exists(assets) && Directory.Exists(Path.GetDirectoryName(receiptPath)) && !File.Exists(receiptPath));
                foreach (string path in new[] { assets, Path.GetDirectoryName(receiptPath), Application.ExecutablePath }) OrdinaryPath(path);
                Require(AppUpdateInstaller.EligibilityError(true) == null);
                settingsHash = Hash(Program.ConfigPath);
                receipt.settingsSha256 = settingsHash;
                using (Process own = Process.GetCurrentProcess()) {
                    receipt.fixturePid = (uint)own.Id; receipt.fixtureStartedUtcTicks = own.StartTime.ToUniversalTime().Ticks;
                }
                transport = new PinnedTransport(assets);
                ReadWarningConsent(assets);
                uiThread = GetCurrentThreadId();
                watchdogPath = Path.Combine(root, "private-fixture-watchdog.json");
                Require(!File.Exists(watchdogPath) && !File.Exists(watchdogPath + ".next"));
                AppDomain.CurrentDomain.FirstChanceException += FirstChance;
                watchdog = new Thread(Watchdog) { IsBackground = true, Name = "Private updater observer" };
                watchdog.Start();
                Write("starting-production-app");
                Application.Idle += Idle;
                return NormalMain(new string[0]);
            } catch (Exception error) {
                Fail(error); return 2;
            } finally {
                watchdogStop.Set();
                if (watchdog != null) watchdog.Join(1500);
                AppDomain.CurrentDomain.FirstChanceException -= FirstChance;
                if (timer != null) timer.Dispose();
                if (transport != null) transport.Dispose();
            }
        }

        static int NormalMain(string[] args)
        {
            MethodInfo main = typeof(Program).GetMethod("Main", Static, null, new[] { typeof(string[]) }, null);
            Require(main != null);
            try { return (int)main.Invoke(null, new object[] { args }); }
            catch (TargetInvocationException error) { throw error.InnerException ?? error; }
        }
        internal static AppUpdateService CreateUpdateService()
        {
            Require(transport != null);
            return new AppUpdateService(transport, new AppUpdateStaging());
        }
        static IEnumerable<Control> Descendants(Control root)
        {
            foreach (Control child in root.Controls) {
                yield return child;
                foreach (Control descendant in Descendants(child)) yield return descendant;
            }
        }
        static void Idle(object sender, EventArgs e)
        {
            if (timer != null) return;
            try {
                SettingsForm settings = Application.OpenForms.OfType<SettingsForm>().SingleOrDefault();
                if (settings == null) { Require(clock.ElapsedMilliseconds < 30000); return; }
                var controller = (Controller)typeof(SettingsForm).GetField("controller", Instance).GetValue(settings);
                Require(controller != null && controller.DesktopRuntime && AppUpdateInstaller.InstallError(controller) == null);
                Require(Hash(Program.ConfigPath) == settingsHash);
                Application.Idle -= Idle;
                var tabs = Descendants(settings).OfType<TabControl>().Single(tab => tab.AccessibleName == "Sections");
                var settingsPage = tabs.TabPages.Cast<TabPage>().Single(page => page.Text == "Settings");
                tabs.SelectedTab = settingsPage;
                var check = Descendants(settingsPage).OfType<Button>().Single(button => button.AccessibleName == "Check for updates");
                Require(check.Visible && check.Enabled);
                Write("checking-private-feed");
                check.PerformClick();
                updateForm = (AppUpdateForm)typeof(SettingsForm).GetField("updateForm", Instance).GetValue(settings);
                Require(updateForm != null && updateForm.Visible && Object.ReferenceEquals(updateForm.Owner, settings));
                primary = Field<Button>("primary");
                updateForm.FormClosed += Closed;
                timer = new System.Windows.Forms.Timer { Interval = 50 };
                timer.Tick += Tick; timer.Start();
            } catch (Exception error) { Fail(error); Application.Exit(); }
        }
        static T Field<T>(string name)
        { return (T)typeof(AppUpdateForm).GetField(name, Instance).GetValue(updateForm); }
        static void Tick(object sender, EventArgs e)
        {
            if (receipt.status == "launched" || receipt.status == "failed") return;
            if (handling) return;
            Interlocked.Increment(ref timerTicks);
            handling = true;
            try {
                Require(clock.ElapsedMilliseconds < 180000 && Hash(Program.ConfigPath) == settingsHash);
                if (stage == 2 || stage == 4) { HandleConfirmation(stage == 4); return; }
                Require(updateForm != null && !updateForm.IsDisposed);
                bool busy = Field<bool>("busy");
                if (stage == 5) ObserveStage5(busy);
                if (busy) {
                    if (stage == 1) {
                        int progress = Field<ProgressBar>("progress").Value;
                        if (progress > 0 && progress < 100) receipt.intermediateProgressObserved = true;
                    }
                    return;
                }
                if (stage == 0) {
                    var release = Field<AppUpdateRelease>("release");
                    Require(release != null && release.Version == Target && primary.Enabled && Field<Label>("state").Text == "Version " + Target + " is available.");
                    receipt.checkedFeed = true; stage = 1; Write("downloading"); primary.PerformClick();
                } else if (stage == 1) {
                    var verified = Field<VerifiedAppUpdate>("verified");
                    Require(verified != null && verified.Version == Target && verified.Sha256 == SetupHash);
                    verified.VerifyForLaunch();
                    retainedVerified = verified;
                    // VerifyForLaunch also rechecks the staging implementation's
                    // live, pinned Internet Zone lease. Framework File.Exists
                    // on an ADS string is not a reliable additional proof.
                    Require(Hash(verified.InstallerPath) == SetupHash);
                    receipt.downloaded = true; receipt.realStaging = true; receipt.progressEvents = transport.ReadEvents;
                    receipt.setupPath = verified.InstallerPath; receipt.setupSha256 = SetupHash;
                    Require(receipt.progressEvents > 1 && receipt.intermediateProgressObserved && primary.Enabled && Field<ProgressBar>("progress").Value == 100);
                    stage = 2; dialogHandled = false; Write("declining-first-install");
                    // Timer reentrancy is required while MessageBox owns its
                    // nested modal loop. Only our own exact consent is clicked.
                    handling = false; primary.PerformClick();
                } else if (stage == 3) {
                    Require(dialogHandled && Object.ReferenceEquals(retainedVerified, Field<VerifiedAppUpdate>("verified")) && Field<Label>("state").Text == "The update is ready when you are.");
                    Require(ActiveLaunch() == null);
                    retainedDescriptorReturnedAfterNo = true;
                    receipt.declinedInstallConfirmed = true;
                    stage = 4; dialogHandled = false; Write("confirming-install");
                    handling = false; primary.PerformClick();
                } else if (stage == 5) {
                    // Launch is asynchronous after confirmation. Closed writes
                    // the native Process identity before Setup closes this app.
                    Require(dialogHandled);
                } else throw new InvalidOperationException("Unexpected fixture phase.");
            } catch (Exception error) { Fail(error); Application.Exit(); }
            finally { handling = false; }
        }
        static object ActiveLaunch()
        { return typeof(AppUpdateInstaller).GetField("activeLaunch", Static).GetValue(null); }
        static bool Launching()
        { return (bool)typeof(AppUpdateInstaller).GetField("launching", Static).GetValue(null); }
        static void ObserveStage5(bool busy)
        {
            receipt.timerTicks = Interlocked.CompareExchange(ref timerTicks, 0, 0);
            receipt.stage5Busy = busy; receipt.stage5Closing = Field<bool>("closing");
            receipt.stage5Launching = Launching(); receipt.stage5ActiveLaunch = ActiveLaunch() != null;
            receipt.afterYesClickReturned = afterYesClickReturned;
            string text = Field<Label>("state").Text;
            receipt.stage5UiState = text == "Could not start the update." ? "GenericLaunchFailure" :
                text == "Checking the installer before opening Setup..." ? "VerificationOrShellWait" :
                text == "Setup is opening. Follow its instructions to finish updating." ? "SetupOpening" :
                text == AppUpdateInstaller.ApprovalError ? "ApprovalRejected" : "Other";
            CopyException(receipt);
            long now = Stopwatch.GetTimestamp();
            if (stage5Published == 0 || now - stage5Published >= Stopwatch.Frequency) {
                stage5Published = now; Write("post-confirmation-wait");
            }
            if (!busy && !receipt.stage5Closing && !receipt.stage5ActiveLaunch) {
                receipt.phase = "launch-settled-without-process";
                throw new InvalidOperationException("The unchanged updater settled without an authenticated installer process.");
            }
        }
        static void CopyException(Receipt value)
        {
            lock (exceptionGate) {
                value.launchExceptionType = launchExceptionType; value.launchExceptionHresult = launchExceptionHresult;
                value.launchNativeError = launchNativeError; value.launchExceptionCount = launchExceptionCount;
            }
        }
        static void FirstChance(object sender, FirstChanceExceptionEventArgs args)
        {
            if (Interlocked.CompareExchange(ref stage, 0, 0) != 5 || Interlocked.CompareExchange(ref firstChanceHandling, 1, 0) != 0) return;
            try {
                // Observe only exceptions inside this exact unchanged install
                // implementation. No message, stack, file or arbitrary data is
                // persisted; stack inspection requests no source filenames.
                var frames = new StackTrace(false).GetFrames();
                bool matched = frames != null && frames.Any(frame => {
                    MethodBase method = frame.GetMethod(); Type owner = method == null ? null : method.DeclaringType;
                    return owner != null && owner.FullName != null && owner.FullName.StartsWith("TaskbarSelect.AppUpdateInstaller", StringComparison.Ordinal);
                });
                if (!matched) return;
                Exception error = args.Exception;
                var native = error as System.ComponentModel.Win32Exception;
                lock (exceptionGate) {
                    launchExceptionType = error.GetType().Name; launchExceptionHresult = error.HResult;
                    launchNativeError = native == null ? 0 : native.NativeErrorCode; launchExceptionCount++;
                }
            } catch (Exception) { }
            finally { Interlocked.Exchange(ref firstChanceHandling, 0); }
        }
        static void Closed(object sender, FormClosedEventArgs e)
        {
            if (receipt.status == "failed") return;
            try {
                Require(stage == 5 && dialogHandled && receipt.confirmedInstall);
                object session = ActiveLaunch(); Require(session != null);
                Require(Object.ReferenceEquals(retainedVerified, session.GetType().GetField("update", Instance).GetValue(session)));
                Process setup = (Process)session.GetType().GetField("process", Instance).GetValue(session);
                Require(setup != null && !setup.HasExited && Same(setup.MainModule.FileName, receipt.setupPath));
                Require(Hash(receipt.setupPath) == SetupHash && AppUpdateInstaller.StartInfo(receipt.setupPath).Arguments == "");
                receipt.setupPid = (uint)setup.Id; receipt.setupStartedUtcTicks = setup.StartTime.ToUniversalTime().Ticks;
                Interlocked.Exchange(ref setupIdentityAuthenticated, 1);
                receipt.status = "launched"; Write("setup-launch"); timer.Stop();
            } catch (Exception error) { Fail(error); Application.Exit(); }
        }

