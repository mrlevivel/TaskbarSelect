            object value; if (raw.TryGetValue(name, out value)) { if (name == "hresult" && value == null) continue; Require(value is int || value is long); safe.Add(name, value); }
        }
        foreach (string name in new[] { "hostHresult", "baseHresult", "hostReadLastHresult", "failureLine", "hostReadRetries", "hostLaunchExceptionHresult", "hostLaunchNativeError", "hostTimerTicks", "hostLaunchExceptionCount", "watchLaunchExceptionHresult", "watchLaunchNativeError", "watchSample", "watchStage", "watchTimerTicks", "watchInstallDialogCount", "watchSecurityDialogCount", "watchUnknownDialogCount", "watchUnresponsiveDialogCount", "watchLaunchExceptionCount", "normalUnsignedWarningRunCount", "wizardHresult", "wizardButtons", "wizardUnknownWindowObservations", "helperHresult" }) {
            object rawNumber;
            if (!raw.TryGetValue(name, out rawNumber) || rawNumber == null) continue;
            Require(rawNumber is int || rawNumber is long);
            long value = Convert.ToInt64(rawNumber, CultureInfo.InvariantCulture);
            Require(value >= Int32.MinValue && value <= Int32.MaxValue);
            if (name == "failureLine" || name == "hostReadRetries" || name == "hostTimerTicks" || name == "hostLaunchExceptionCount" ||
                name == "watchSample" || name == "watchStage" || name == "watchTimerTicks" || name == "watchInstallDialogCount" ||
                name == "watchSecurityDialogCount" || name == "watchUnknownDialogCount" || name == "watchUnresponsiveDialogCount" || name == "watchLaunchExceptionCount" || name == "normalUnsignedWarningRunCount" || name == "wizardButtons" || name == "wizardUnknownWindowObservations") Require(value >= 0);
            safe.Add(name, (int)value);
        }
        CopyPrivateWarningInputTelemetry(raw, safe);
        File.WriteAllText(Path.Combine(boundaryEvidence, "private-updater-result.json"), new JavaScriptSerializer().Serialize(safe), new UTF8Encoding(false));
    }

    // Diagnostic export only. Input admission, sequencing, consent and launch
    // acceptance are unchanged. Never retain paths, handles or arbitrary text.
    internal static void CopyPrivateWarningInputTelemetry(Dictionary<string, object> raw, Dictionary<string, object> safe)
    {
        object value;
        safe["warningInputTelemetryExportMissing"] = !raw.TryGetValue("warningInputTelemetry", out value);
        safe["warningInputTelemetryExportInvalid"] = false;
        object invalid;
        if (raw.TryGetValue("warningInputTelemetryInvalid", out invalid)) {
            if (invalid is bool) safe["warningInputTelemetryInvalid"] = invalid;
            else { safe["warningInputTelemetryInvalid"] = true; safe["warningInputTelemetryExportInvalid"] = true; }
        }
        if ((bool)safe["warningInputTelemetryExportMissing"]) return;
        try {
            var telemetry = value as Dictionary<string, object>;
            string[] numbers = { "version", "phase", "revision", "sequenceOutcome", "moveEvents", "buttonEvents", "pointerSamples",
                "virtualX", "virtualY", "virtualWidth", "virtualHeight", "runLeft", "runTop", "runRight", "runBottom", "intendedX", "intendedY", "normalizedX", "normalizedY",
                "clipLeft", "clipTop", "clipRight", "clipBottom", "moveX", "moveY", "postX", "postY", "preflightMs", "consumedMs", "moveStartedMs", "moveReturnedMs", "pointerMs", "proofMs", "buttonsStartedMs", "buttonsReturnedMs", "postMs" };
            string[] booleans = { "clipQuerySucceeded", "intendedInsideClip", "moveCallStarted", "moveReturned", "moveCursorQuerySucceeded", "moveInsideRun", "moveHitOwnedRun", "moveHitOwnedWarning", "pointerVerified", "finalProofObserved", "finalProofVerified", "proofClipQuerySucceeded", "proofClipAllowsPoint", "buttonsCallStarted", "buttonsReturned", "postCursorQuerySucceeded", "postEqualsIntended", "postInsideRun", "postHitOwnedRun", "postHitOwnedWarning", "warningStillPresent" };
            if (telemetry == null || telemetry.Count != numbers.Length + booleans.Length ||
                telemetry.Keys.Any(k => !numbers.Contains(k, StringComparer.Ordinal) && !booleans.Contains(k, StringComparer.Ordinal))) throw new InvalidOperationException();
            var copy = new Dictionary<string, object>(StringComparer.Ordinal);
            foreach (string name in numbers) {
                object number; if (!telemetry.TryGetValue(name, out number) || !(number is int || number is long)) throw new InvalidOperationException();
                long n = Convert.ToInt64(number, CultureInfo.InvariantCulture);
                if (n < Int32.MinValue || n > Int32.MaxValue ||
                    (name.EndsWith("Ms", StringComparison.Ordinal) && (n < 0 || n > 300000)) ||
                    ((name == "normalizedX" || name == "normalizedY") && (n < 0 || n > 65535)) ||
                    ((name == "virtualWidth" || name == "virtualHeight") && (n < 0 || n > 32768)) ||
                    (name == "version" && n != 1) || ((name == "phase" || name == "sequenceOutcome") && (n < 0 || n > 7)) ||
                    (name == "revision" && (n < 0 || n > 4096)) || (name == "moveEvents" && (n < 0 || n > 1)) ||
                    (name == "buttonEvents" && (n < 0 || n > 2)) || (name == "pointerSamples" && (n < 0 || n > 32))) throw new InvalidOperationException();
                copy.Add(name, (int)n);
            }
            foreach (string name in booleans) { object flag; if (!telemetry.TryGetValue(name, out flag) || !(flag is bool)) throw new InvalidOperationException(); copy.Add(name, flag); }
            // The child already validates all temporal/geometric relationships.
            // Preserve its exact bounded values; do not infer acceptance here.
            safe.Add("warningInputTelemetry", copy);
        } catch (Exception) {
            safe["warningInputTelemetryExportInvalid"] = true;
            safe["normalUnsignedWarningProofInvalid"] = true;
            // Existing attempted/count/consent evidence stays present unchanged.
        }
    }
    sealed class PrivateUpdaterTarget : NativeWindow, IDisposable
    {
        internal PrivateUpdaterTarget() { CreateHandle(new CreateParams { Caption = "Owned private updater CI identity target", Width = 1, Height = 1, X = -30000, Y = -30000 }); }
        public void Dispose() { DestroyHandle(); }
    }
    [StructLayout(LayoutKind.Sequential)] struct PrivateUpdaterMessage
    { internal IntPtr Window; internal uint Id; internal UIntPtr WParam; internal IntPtr LParam; internal uint Time; internal int X, Y; internal uint Private; }
    [DllImport("user32.dll", SetLastError = true)] static extern uint MsgWaitForMultipleObjectsEx(uint count, IntPtr[] handles, uint milliseconds, uint wakeMask, uint flags);
    [DllImport("user32.dll", EntryPoint = "PeekMessageW", CharSet = CharSet.Unicode, ExactSpelling = true)] static extern bool PeekMessage(out PrivateUpdaterMessage message, IntPtr window, uint minimum, uint maximum, uint remove);
    [DllImport("user32.dll")] static extern bool TranslateMessage(ref PrivateUpdaterMessage message);
    [DllImport("user32.dll", EntryPoint = "DispatchMessageW", CharSet = CharSet.Unicode, ExactSpelling = true)] static extern IntPtr DispatchMessage(ref PrivateUpdaterMessage message);
    static bool WaitPrivateUpdaterMedium(Life child)
    {
        var clock = Stopwatch.StartNew(); IntPtr[] handles = { child.Handle };
        for (;;) {
            if (child.Exited(0)) return true;
            long remaining = 160000 - clock.ElapsedMilliseconds; if (remaining <= 0) return false;
            uint state = MsgWaitForMultipleObjectsEx(1, handles, (uint)Math.Min(1000, remaining), 0x04ff, 4);
            if (state == 0) return true;
            if (state == 258) continue;
            if (state == UInt32.MaxValue) throw new NativeFailure(Last());
            Require(state == 1);
            for (int count = 0; count < 64; count++) {
                PrivateUpdaterMessage message; if (!PeekMessage(out message, IntPtr.Zero, 0, 0, 1)) break;
                if (message.Id == 0x12) throw new NativeFailure(1223);
                TranslateMessage(ref message); DispatchMessage(ref message);
            }
        }
    }
    static int PrivateUpdaterHigh(PipeStream sponsor, string app, string runtime, uint sponsorPid, long sponsorStarted, string source)
    {
        string phase = "validate-target"; int checks = 0; bool metadataOnly = false, setupObservationOnly = false;
        try {
            Require(FileHashForBoundary(app) == PrivateUpdaterAppHash); checks++;
            string metadataMode = Path.Combine(Path.GetDirectoryName(app), "private-updater-input", PrivateAttachmentMetadataModeName);
            string observationMode = Path.Combine(Path.GetDirectoryName(app), "private-updater-input", PrivateSetupObservationModeName);
            metadataOnly = File.Exists(metadataMode);
            setupObservationOnly = File.Exists(observationMode);
            Require(!(metadataOnly && setupObservationOnly));
            // HIGH is authenticated by the unchanged transferred parent/image
            // grant, not by inherited hosted environment fields: Shell runas
            // may rebuild its environment. ROOT already validated the actual
            // event/run and copied this protected marker hash-for-hash; HIGH
            // checks its exact source-bound shape. MED independently requires
            // its unchanged sponsor-inherited actual run before any probe.
            if (metadataOnly) ReadPrivateAttachmentMetadataMode(metadataMode, source);
            if (setupObservationOnly) ReadPrivateSetupObservationMode(observationMode, source);
            using (var target = new PrivateUpdaterTarget()) {
                phase = "request-medium";
                CaseIdentity child = RequestBoundaryCase(sponsor, 0, Guid.NewGuid().ToString("N"), target.Handle);
                Require(VerifyBoundaryCase(child)); checks++;
                using (var owned = Life.Open(child.Id, child.Started)) {
                    owned.Pin(selfPath); phase = "wait-medium";
                    Require(WaitPrivateUpdaterMedium(owned) && owned.Exit() == 0); checks++;
                }
            }
            phase = "validate-receipt";
            var receipt = ReadPrivateUpdaterReceipt(Path.Combine(runtime, "private-updater-result.json"));
            if (setupObservationOnly) {
                Require((string)receipt["schema"] == "taskbar-select-private-setup-observation-result-v1" && (string)receipt["status"] == "observed" &&
                    (string)receipt["sourceSha"] == source && (string)receipt["setupSha256"] == PrivateUpdaterSetupHash &&
                    (bool)receipt["setupObservationOnly"] && !(bool)receipt["fullUpdateTested"] && !(bool)receipt["updaterPassed"] &&
                    (bool)receipt["observationCompleted"] && (bool)receipt["noInput"] && (bool)receipt["noInstallActions"] &&
                    !(bool)receipt["globalInput"] && !(bool)receipt["securityDialogsAutomated"] &&
                    (bool)receipt["observationHelperExited"] && (bool)receipt["observationHelperReceiptOwnerVerified"] && (bool)receipt["observationHelperHashVerified"]);
                checks++;
                File.WriteAllText(Path.Combine(runtime, "result.json"), new JavaScriptSerializer().Serialize(new {
                    schema = "taskbar-select-private-updater-ci-v1", status = "passed", sourceSha = source,
                    appSha256 = PrivateUpdaterAppHash, setupSha256 = PrivateUpdaterSetupHash, checks = checks,
                    metadataOnly = false, setupObservationOnly = true, fullUpdateTested = false,
                    genuineMediumSetupObservationPassed = true, genuineMediumMetadataProbePassed = false, genuineMediumUpdaterPassed = false,
                    publicGitHubTested = false, interactiveUacTested = false, rememberedApprovalLifecycleExecuted = false, rebootTested = false
                }), new UTF8Encoding(false)); return 0;
            }
            if (metadataOnly) {
                Require((string)receipt["schema"] == "taskbar-select-private-attachment-metadata-result-v1" && (string)receipt["status"] == "passed" &&
                    (string)receipt["sourceSha"] == source && (bool)receipt["metadataOnly"] && !(bool)receipt["fullUpdateTested"] &&
                    (bool)receipt["nonExecuting"] && !(bool)receipt["executeApiCalled"] && !(bool)receipt["promptApiCalled"] &&
                    !(bool)receipt["saveWithUiApiCalled"] && (bool)receipt["cleanupConfirmed"] && (bool)receipt["metadataHelperExited"] &&
                    (bool)receipt["metadataHelperReceiptOwnerVerified"] && (bool)receipt["metadataHelperHashVerified"]);
                foreach (string prefix in new[] { "baseline", "contentPin", "contentAndZonePin", "afterZoneRelease" }) Require((bool)receipt[prefix + "SaveCalled"]);
                checks++;
                File.WriteAllText(Path.Combine(runtime, "result.json"), new JavaScriptSerializer().Serialize(new {
                    schema = "taskbar-select-private-updater-ci-v1", status = "passed", sourceSha = source,
                    appSha256 = PrivateUpdaterAppHash, setupSha256 = PrivateUpdaterSetupHash, checks = checks,
                    metadataOnly = true, setupObservationOnly = false, fullUpdateTested = false, nonExecuting = true,
                    genuineMediumMetadataProbePassed = true, genuineMediumUpdaterPassed = false, genuineMediumSetupObservationPassed = false,
                    publicGitHubTested = false, interactiveUacTested = false, rememberedApprovalLifecycleExecuted = false, rebootTested = false
                }), new UTF8Encoding(false)); return 0;
            }
            Require((string)receipt["schema"] == "taskbar-select-private-update-e2e-v1" && (string)receipt["status"] == "passed" &&
                (string)receipt["sourceSha"] == source && (string)receipt["appSha256"] == PrivateUpdaterAppHash &&
                (string)receipt["setupSha256"] == PrivateUpdaterSetupHash && (bool)receipt["settingsPreserved"] &&
                (bool)receipt["reopenedExactTarget"] && (bool)receipt["cleanupConfirmed"] && (bool)receipt["sourceBuiltPredecessor"] &&
                !(bool)receipt["exactReleasedBeta17"] && !(bool)receipt["publicGitHubTested"]); checks++;
            File.WriteAllText(Path.Combine(runtime, "result.json"), new JavaScriptSerializer().Serialize(new {
                schema = "taskbar-select-private-updater-ci-v1", status = "passed", sourceSha = source,
                appSha256 = PrivateUpdaterAppHash, setupSha256 = PrivateUpdaterSetupHash, checks = checks,
                metadataOnly = false, setupObservationOnly = false, fullUpdateTested = true, genuineMediumMetadataProbePassed = false, genuineMediumSetupObservationPassed = false,
                genuineMediumUpdaterPassed = true, publicGitHubTested = false, interactiveUacTested = false,
                rememberedApprovalLifecycleExecuted = false, rebootTested = false
            }), new UTF8Encoding(false)); return 0;
        } catch (Exception error) {
            File.WriteAllText(Path.Combine(runtime, "result.json"), new JavaScriptSerializer().Serialize(new {
                schema = "taskbar-select-private-updater-ci-v1", status = "failed", sourceSha = source,
                appSha256 = PrivateUpdaterAppHash, checks = checks, phase = phase, errorType = error.GetType().Name,
                hresult = error.HResult, metadataOnly = metadataOnly, setupObservationOnly = setupObservationOnly, fullUpdateTested = false,
                genuineMediumMetadataProbePassed = false, genuineMediumUpdaterPassed = false, genuineMediumSetupObservationPassed = false,
                publicGitHubTested = false, interactiveUacTested = false
            }), new UTF8Encoding(false)); return 2;
        }
    }
    static int PrivateUpdaterMedium(string[] args)
    {
        Require(args[4] == BoundaryScenarios[0] && FreshNonce(args[3]));
        string app = Path.GetFullPath(args[1]), runtime = Path.GetFullPath(args[2]), source = Path.GetDirectoryName(selfPath);
        Require(String.Equals(app, Path.Combine(source, "TaskbarSelect.exe"), StringComparison.OrdinalIgnoreCase) &&
            String.Equals(runtime, Path.Combine(Path.GetDirectoryName(source), Path.GetFileName(source).Replace("TaskbarSelectCiSource.", "TaskbarSelectCiRuntime.")), StringComparison.OrdinalIgnoreCase));
        IntPtr current = IntPtr.Zero, elevated = IntPtr.Zero;
        try {
            if (!OpenProcessToken(GetCurrentProcess(), 8, out current)) throw new NativeFailure(Last()); Token own = Read(current);
            Require(own.Type == 1 && Medium(own));
            using (var high = Life.Open(UInt32.Parse(args[5], CultureInfo.InvariantCulture), Int64.Parse(args[6], CultureInfo.InvariantCulture))) {
                high.Pin(selfPath); Require(ActualPair(ProcessToken(high, 8, out elevated), own));
                uint owner; Require(GetWindowThreadProcessId(new IntPtr(Int64.Parse(args[7], CultureInfo.InvariantCulture)), out owner) != 0 && owner == high.Pid);
            }
        } finally { if (elevated != IntPtr.Zero) CloseHandle(elevated); if (current != IntPtr.Zero) CloseHandle(current); }
        string input = Path.Combine(source, "private-updater-input"), clone = Path.Combine(runtime, "private-updater-input");
        Require(!Directory.Exists(clone)); Directory.CreateDirectory(clone);
        foreach (string name in PrivateUpdaterAssets.Concat(PrivateUpdaterScripts)) {
            string from = Path.Combine(input, name), to = Path.Combine(clone, name);
            PrivateUpdaterFile(from); File.Copy(from, to, false); Require(FileHashForBoundary(from) == FileHashForBoundary(to));
        }
        string consent = Path.Combine(input, PrivateUpdaterConsentName);
        string metadataMode = Path.Combine(input, PrivateAttachmentMetadataModeName);
        string observationMode = Path.Combine(input, PrivateSetupObservationModeName);
        if (File.Exists(observationMode)) {
            string sourceSha = Environment.GetEnvironmentVariable("GITHUB_SHA");
            ValidatePrivateSetupObservationMode(observationMode, sourceSha);
            string target = Path.Combine(clone, PrivateSetupObservationModeName);
            File.Copy(observationMode, target, false); Require(FileHashForBoundary(observationMode) == FileHashForBoundary(target));
            ValidatePrivateSetupObservationMode(target, sourceSha);
        }
        if (File.Exists(metadataMode)) {
            string sourceSha = Environment.GetEnvironmentVariable("GITHUB_SHA");
            ValidatePrivateAttachmentMetadataMode(metadataMode, sourceSha);
            string target = Path.Combine(clone, PrivateAttachmentMetadataModeName);
            File.Copy(metadataMode, target, false); Require(FileHashForBoundary(metadataMode) == FileHashForBoundary(target));
            ValidatePrivateAttachmentMetadataMode(target, sourceSha);
        }
        if (File.Exists(consent)) {
            Require(!File.Exists(metadataMode));
            string sourceSha = Environment.GetEnvironmentVariable("GITHUB_SHA");
            ValidatePrivateUpdaterConsent(consent, sourceSha);
            string target = Path.Combine(clone, PrivateUpdaterConsentName);
            File.Copy(consent, target, false); Require(FileHashForBoundary(consent) == FileHashForBoundary(target));
            ValidatePrivateUpdaterConsent(target, sourceSha);
        }
        var start = new ProcessStartInfo(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Windows), "System32/WindowsPowerShell/v1.0/powershell.exe"),
            "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File " + Quote(Path.Combine(clone, "private-updater-child.ps1")) + " -Runtime " + Quote(runtime)) {
            UseShellExecute = false, CreateNoWindow = true, WorkingDirectory = clone, RedirectStandardOutput = true, RedirectStandardError = true
        };
        // The unchanged sponsor allowlist omits repository identity. After its
        // actual-token/parent authentication, supply only this fixed nonsecret
        // fixture scope; never copy credentials or broaden that shared policy.
        start.EnvironmentVariables["GITHUB_REPOSITORY"] = "mrlevivel/TaskbarSelect";
        using (var child = Process.Start(start)) {
            int stdoutClosed = 0, stderrClosed = 0;
            // Never relay raw child output: installer and profile logs may hold
            // disposable account paths. Only bounded final schema is exported.
            child.OutputDataReceived += delegate(object sender, DataReceivedEventArgs line) { if (line.Data == null) Interlocked.Exchange(ref stdoutClosed, 1); };
            child.ErrorDataReceived += delegate(object sender, DataReceivedEventArgs line) { if (line.Data == null) Interlocked.Exchange(ref stderrClosed, 1); };
            child.BeginOutputReadLine(); child.BeginErrorReadLine();
            Require(child.WaitForExit(150000));
            Require(Wait(delegate { return Interlocked.CompareExchange(ref stdoutClosed, 0, 0) != 0 && Interlocked.CompareExchange(ref stderrClosed, 0, 0) != 0; }, 2000));
            return child.ExitCode;
        }
    }
}
