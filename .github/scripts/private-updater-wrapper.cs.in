        string[] keys = { "schema", "sourceSha", "setupSha256", "runId", "NormalOpenFileWarningOnly", "oneTime" };
        Require(value != null && value.Count == keys.Length && keys.All(key => value.ContainsKey(key)));
        string run = Environment.GetEnvironmentVariable("GITHUB_RUN_ID");
        Require(run != null && run.Length >= 1 && run.Length <= 20 && run.All(c => c >= '0' && c <= '9') &&
            value["schema"] as string == "taskbar-select-private-unsigned-warning-consent-v1" && value["sourceSha"] as string == source &&
            value["setupSha256"] as string == PrivateUpdaterSetupHash && value["runId"] as string == run &&
            value["NormalOpenFileWarningOnly"] is bool && (bool)value["NormalOpenFileWarningOnly"] &&
            value["oneTime"] is bool && (bool)value["oneTime"]);
    }
    static bool PrivateAttachmentMetadataModeShape(Dictionary<string, object> value, string source)
    {
        string[] keys = { "schema", "sourceSha", "runId", "metadataOnly" };
        if (!SourceSha(source) || value == null || value.Count != keys.Length || !keys.All(key => value.ContainsKey(key))) return false;
        string run = value["runId"] as string;
        return run != null && run.Length >= 1 && run.Length <= 20 && run.All(c => c >= '0' && c <= '9') &&
            value["schema"] as string == "taskbar-select-private-attachment-metadata-mode-v1" && value["sourceSha"] as string == source &&
            value["metadataOnly"] is bool && (bool)value["metadataOnly"];
