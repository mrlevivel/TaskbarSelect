    static void StagePrivateUpdaterInputs(string source)
    {
        Require(FileHashForBoundary(boundaryInputApp) == PrivateUpdaterAppHash &&
            FileVersionInfo.GetVersionInfo(boundaryInputApp).ProductVersion == "1.0.0-beta.18");
        string repo = Path.GetDirectoryName(Path.GetDirectoryName(boundaryInputApp));
        string root = Path.Combine(source, "private-updater-input"); Require(!Directory.Exists(root)); Directory.CreateDirectory(root);
        foreach (string name in PrivateUpdaterAssets)
            StagePrivateUpdaterFile(Path.Combine(repo, "artifacts/private-updater-input", name), root, name);
        foreach (string name in PrivateUpdaterScripts)
            StagePrivateUpdaterFile(Path.Combine(repo, "artifacts/private-updater-input", name), root, name);
        string consent = Path.Combine(repo, "artifacts/private-updater-input", PrivateUpdaterConsentName);
        string metadataMode = Path.Combine(repo, "artifacts/private-updater-input", PrivateAttachmentMetadataModeName);
        string observationMode = Path.Combine(repo, "artifacts/private-updater-input", PrivateSetupObservationModeName);
        Require(!File.Exists(observationMode) && !File.Exists(metadataMode));
        if (File.Exists(observationMode)) {
            ValidatePrivateSetupObservationMode(observationMode, boundarySourceSha);
            StagePrivateUpdaterFile(observationMode, root, PrivateSetupObservationModeName);
            ValidatePrivateSetupObservationMode(Path.Combine(root, PrivateSetupObservationModeName), boundarySourceSha);
        }
        if (File.Exists(metadataMode)) {
            ValidatePrivateAttachmentMetadataMode(metadataMode, boundarySourceSha);
            StagePrivateUpdaterFile(metadataMode, root, PrivateAttachmentMetadataModeName);
            ValidatePrivateAttachmentMetadataMode(Path.Combine(root, PrivateAttachmentMetadataModeName), boundarySourceSha);
        }
        if (File.Exists(consent)) {
            Require(!File.Exists(metadataMode));
            ValidatePrivateUpdaterConsent(consent, boundarySourceSha);
            StagePrivateUpdaterFile(consent, root, PrivateUpdaterConsentName);
            ValidatePrivateUpdaterConsent(Path.Combine(root, PrivateUpdaterConsentName), boundarySourceSha);
        }
        Require(FileHashForBoundary(Path.Combine(root, "TaskbarSelect-1.0.0-beta.18-Setup.exe")) == PrivateUpdaterSetupHash);
    }
    static void RemovePrivateUpdaterInputs(string source)
    {
        string root = Path.Combine(source, "private-updater-input");
        foreach (string path in privateUpdaterStaged) {
            Require(Path.GetDirectoryName(path) == root); PrivateUpdaterFile(path); File.Delete(path);
        }
        // Exact files, then an empty owned directory. Never recursive deletion.
        Directory.Delete(root, false);
    }
