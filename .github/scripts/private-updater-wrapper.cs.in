    internal static int PrivateUpdaterMain(string[] args)
    {
        try {
            // HIGH is admitted by the unchanged authenticated parent-handle
            // protocol, not spoofable inherited environment variables.
            bool high = args.Length == 10 && args[0] == "--high-boundary";
            if (!high) {
                Hosted();
                Require(Environment.GetEnvironmentVariable("GITHUB_REF") == PrivateUpdaterBranch &&
                    Environment.GetEnvironmentVariable("GITHUB_EVENT_NAME") == "workflow_dispatch");
                if (args.Length == 3 && args[0] == "--run-ci")
                    Require(Environment.GetEnvironmentVariable("GITHUB_REPOSITORY") == "mrlevivel/TaskbarSelect");
            }
            boundaryStageExtension = StagePrivateUpdaterInputs;
            boundaryRemoveExtension = RemovePrivateUpdaterInputs;
            boundaryCopyExtension = CopyPrivateUpdaterEvidence;
            boundaryReceiveTimeout = 170000;
            int result;
            if (TryBoundaryEntry(args, PrivateUpdaterHigh, out result)) return result;
            selfPath = Assembly.GetExecutingAssembly().Location;
            using (var own = new FileStream(selfPath, FileMode.Open, FileAccess.Read, FileShare.Read)) selfHash = Hash(own);
            if (args.Length == 8 && args[0] == "--medium") return PrivateUpdaterMedium(args);
            return 2;
        } catch (Exception error) {
            Console.Error.WriteLine("Private updater fixture refusal hr=0x" + error.HResult.ToString("X8", CultureInfo.InvariantCulture));
            return 2;
        }
    }

    static void PrivateUpdaterFile(string path)
    {
        Require(Path.IsPathRooted(path) && File.Exists(path));
        long size = new FileInfo(path).Length; Require(size > 0 && size <= 64 * 1024 * 1024);
        for (string current = path; current != null; current = Path.GetDirectoryName(current.TrimEnd('\\')))
            Require((File.GetAttributes(current) & FileAttributes.ReparsePoint) == 0);
    }
    static void StagePrivateUpdaterFile(string input, string root, string name)
    {
        Require(name == Path.GetFileName(name) && (PrivateUpdaterAssets.Contains(name) || PrivateUpdaterScripts.Contains(name) || name == PrivateUpdaterConsentName || name == PrivateAttachmentMetadataModeName || name == PrivateSetupObservationModeName));
